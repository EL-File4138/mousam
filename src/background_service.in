#!@PYTHON@

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('mousam', localedir)
locale.textdomain('mousam')

gettext.bindtextdomain('mousam', localedir)
gettext.textdomain('mousam')
gettext.install('mousam', localedir)

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'mousam.gresource'))
    resource._register()

    from mousam import background_main
    sys.exit(background_main.main(VERSION))
