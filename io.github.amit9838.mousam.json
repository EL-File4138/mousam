{
    "app-id": "io.github.amit9838.mousam",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "mousam",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--system-talk-name=org.freedesktop.GeoClue2",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "data/dependencies/python3-requests.json",
        {
            "name" : "geocode-glib",
            "config-opts" : [
                "-Denable-installed-tests=false",
                "-Denable-gtk-doc=false",
                "-Dsoup2=false"
            ],
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/geocode-glib.git",
                    "tag" : "3.26.4"
                }
            ]
        },
        {
            "name" : "libgweather",
            "config-opts" : [
                "-Denable_vala=false",
                "-Dtests=false",
                "-Dgtk_doc=false"
            ],
            "buildsystem" : "meson",
            "modules": [
                {
                    "name" : "gweather-locations",
                    "buildsystem" : "meson",
                    "sources" : [
                        {
                            "type" : "git",
                            "url" : "https://gitlab.gnome.org/GNOME/gweather-locations.git",
                            "tag" : "2026.1"
                        }
                    ]
                }
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/libgweather.git",
                    "tag" : "4.5.0"
                }
            ]
        },
        {
            "name" : "mousam",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dflatpak=true"
            ],
            "sources" : [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
